{
    "latex-workshop.latex.recipes": [
     {
            "name": "latexmk",
            "tools": [
                "latexmk"
            ]
        },
            {
                "name": "latexmk (lualatex)",
                "tools": [
                    "lualatexmk"
                ]
            },
            {
            "name": "latexmk (xelatex)",
            "tools": [
                "xelatexmk"
            ]
        },
        ],
    "latex-workshop.latex.tools": [
        {
            "name": "lualatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-lualatex",
                "-outdir=%OUTDIR%",
                "-auxdir=%AUXDIR%",
                "%DOC%"
            ],
            "env": {}
        },
                {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "-auxdir=%AUXDIR%",
                "%DOC%"
            ],
            "env": {}
        },
                {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-outdir=%OUTDIR%",
                "-auxdir=%AUXDIR%",
                "%DOC%"
            ],
            "env": {}
        },
    ],
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.latex.auxDir": "%OUTDIR%/aux",
    "latex-workshop.latex.recipe.default": "latexmk (xelatex)",
}